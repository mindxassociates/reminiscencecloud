---
import Base from '../../../layouts/Base.astro'; import { getCollection } from 'astro:content'; import { withBase } from '../../../paths.js';
const posts=(await getCollection('postsZh',p=>p.data.published)).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf());
---
<Base title="心理咨询资源与文章" description="阅读云间拾忆关于哀伤、联结与心理健康的文章，并查找危机支持资源。纽约市英语与普通话成人心理咨询。" locale="zh" counterpart="/blog/"><section class="page-hero"><p class="kicker">博客</p><h1>陪伴您继续探索的阅读。</h1><p>这里仅显示已发布的中文文章。</p></section><section class="cards">{posts.length?posts.map(p=><article><h2><a href={withBase(`/zh/blog/${p.id}/`)}>{p.data.title}</a></h2><p>{p.data.summary}</p></article>):<article><h2>内容即将上线</h2><p>未来发布的中文文章会自动出现在这里。</p></article>}</section></Base>
