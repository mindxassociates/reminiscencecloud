---
import Base from '../../../layouts/Base.astro'; import { getCollection, render } from 'astro:content';
export async function getStaticPaths(){const p=await getCollection('postsZh',x=>x.data.published);return p.map(post=>({params:{id:post.id},props:{post}}))}
const {post}=Astro.props; const {Content}=await render(post);
---
<Base title={post.data.seoTitle||post.data.title} description={post.data.seoDescription||post.data.summary} locale="zh" counterpart="/blog/"><article class="prose"><p class="kicker">博客</p><h1>{post.data.title}</h1><p class="lede">{post.data.summary}</p><Content/></article></Base>
