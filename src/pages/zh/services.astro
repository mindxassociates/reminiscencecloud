---
import Base from '../../layouts/Base.astro'; import Cta from '../../components/Cta.astro'; import page from '../../content/pages/zh/services.json';
import specialties from '../../data/specialties.json';
import { withBase } from '../../paths.js';
---
<Base title={page.title} locale="zh" counterpart="/services/"><section class="page-hero"><p class="kicker">服务</p><h1>{page.heading}</h1><p>{page.intro}</p></section><section class="prose"><p class="kicker">您可以期待什么</p><h2>协作、不急不躁的过程</h2><p>{page.expectation}</p><p>{page.consultation}</p></section><section class="service-list"><div class="section-head"><p class="kicker">关注领域</p><h2>我们可以共同努力的方向</h2></div>{page.items.map((x,i)=><article><span>0{i+1}</span><div><h3>{x.title}</h3><p class="service-tagline">{x.tagline}</p><p>{x.body}</p><ul>{x.methods.map(m=><li>{m}</li>)}</ul><p><a href={withBase(`/zh/${specialties[i].slug}/`)}>进一步了解 →</a></p></div></article>)}</section><section class="soft"><div class="section-head"><p class="kicker">咨询形式</p><h2>我们如何工作</h2></div><div class="format-grid">{page.format.map(x=><div><strong>{x.label}</strong><p>{x.value}</p></div>)}</div></section><Cta locale="zh"/></Base>
