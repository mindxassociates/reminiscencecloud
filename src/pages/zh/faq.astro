---
import Base from '../../layouts/Base.astro'; import Cta from '../../components/Cta.astro'; import page from '../../content/pages/zh/faq.json'; import { withBase } from '../../paths.js';
---
<Base title={page.title} locale="zh" counterpart="/faq/"><section class="page-hero"><p class="kicker">常见问题</p><h1>{page.heading}</h1><p>{page.intro}</p></section><section class="faq">{page.groups.map(group=><section class="faq-group"><h2>{group.title}</h2>{group.items.map(x=>x.answer?<details><summary>{x.question}</summary><p>{x.answer}</p></details>:<div class="faq-question">{x.question}</div>)}</section>)}</section><section class="faq-help"><h2>还有问题吗？</h2><p>我很乐意回答这里没有涵盖的问题。联系我后，我会在 1–2 个工作日内回复。</p><a class="button" href={withBase('/zh/book/')}>预约免费咨询</a></section><Cta locale="zh"/></Base>
