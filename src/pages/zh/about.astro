---
import Base from '../../layouts/Base.astro'; import Cta from '../../components/Cta.astro'; import page from '../../content/pages/zh/about.json';
---
<Base title={page.title} locale="zh" counterpart="/about/"><section class="page-hero"><p class="kicker">关于我</p><h1>{page.heading}</h1><p>{page.subheading}</p></section><section class="split portrait"><img src="/images/coast.jpg" alt="苗秀云 Sharon Miao，LCSW 坐在海边"><div><p class="kicker">心理咨询师</p><h2>{page.name}</h2><p>{page.body}</p><p>{page.secondary}</p></div></section><section class="soft"><div class="section-head"><p class="kicker">培训与资质</p><h2>教育背景与认证</h2></div><div class="credential-grid">{page.credentials.map(x=><article><h3>{x.title}</h3><p>{x.detail}</p></article>)}</div></section><section class="philosophy-wrap"><figure class="botanical-art"><img src="https://images.pexels.com/photos/13217588/pexels-photo-13217588.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=1400" alt="自然光下柔和的蓝色花朵" loading="lazy" referrerpolicy="no-referrer"></figure><div class="prose philosophy"><p class="kicker">我的理念</p><h2>我对疗愈的信念</h2>{page.philosophy.map(p=><p>{p}</p>)}</div></section><Cta locale="zh"/></Base>
