---
import Base from '../../layouts/Base.astro'; import Cta from '../../components/Cta.astro'; import page from '../../content/pages/zh/about.json'; import { withBase } from '../../paths.js';
---
<Base title={page.title} description="了解 Reminiscence Cloud 心理咨询师苗秀云 Sharon Miao，LCSW 的教育背景、咨询方式与培训。纽约市英语及普通话咨询，纽约州、新泽西州及加州线上服务。" locale="zh" counterpart="/about/"><section class="page-hero"><p class="kicker">关于我</p><h1>{page.heading}</h1><p>{page.subheading}</p></section><section class="split portrait"><img src={withBase('/images/portrait.jpg')} alt="苗秀云 Sharon Miao，LCSW 坐在海边"><div><p class="kicker">心理咨询师</p><h2>{page.name}</h2><p>{page.body}</p><p>{page.secondary}</p><p>Reminiscence Cloud 云间拾忆是您在这里了解我的咨询服务与预约的入口。</p><p><a href="https://www.psychologytoday.com/profile/1274912">查看我的 Psychology Today 专业资料</a></p></div></section><section class="soft"><div class="section-head"><p class="kicker">培训与资质</p><h2>教育背景、执照与培训</h2></div><div class="credential-grid">{page.credentials.map(x=><article><h3>{x.title}</h3><p>{x.detail}</p></article>)}</div></section><section class="prose philosophy"><p class="kicker">我的理念</p><h2>我对疗愈的信念</h2>{page.philosophy.map(p=><p>{p}</p>)}</section><Cta locale="zh"/></Base>
