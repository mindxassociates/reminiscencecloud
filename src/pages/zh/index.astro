---
import Base from '../../layouts/Base.astro'; import Cta from '../../components/Cta.astro'; import home from '../../content/pages/zh/home.json'; import settings from '../../content/settings.json'; import { withBase } from '../../paths.js';
import specialties from '../../data/specialties.json';
---
<Base title="纽约普通话心理咨询师 | 苗秀云 Sharon Miao, LCSW" description="苗秀云 Sharon Miao，LCSW，在纽约市提供英语与普通话成人心理咨询，关注创伤、焦虑、哀伤与人生转变。支持纽约州、新泽西州和加州线上咨询，预约免费15分钟电话咨询。" locale="zh" counterpart="/"><section class="hero"><div class="hero-copy"><p class="kicker">{home.eyebrow}</p><h1>{home.title}</h1><p>{home.intro}</p><a class="button" href={withBase(settings.schedulingUrlZh)}>预约免费 15 分钟咨询</a><p class="availability">{home.availability}</p></div></section><section class="intro-story"><div><p class="kicker">认识苗秀云 Sharon Miao，LCSW</p><h2>{home.welcomeTitle}</h2><p>{home.welcomeBody}</p><p>{home.welcomeBodyTwo}</p><p><a href={withBase("/zh/about/")}>了解我的背景与咨询方式 →</a></p></div><img src={withBase('/images/portrait.jpg')} alt="心理咨询师苗秀云 Sharon Miao，LCSW 坐在海边长椅上"></section><section class="soft focus-section"><div class="section-head"><p class="kicker">关注领域</p><h2>我们可以共同面对的问题</h2></div><div class="focus-grid">{home.areas.map((x,i)=><article><h3><a href={withBase(`/zh/${specialties[i].slug}/`)}>{x.title}</a></h3><p>{x.body}</p></article>)}</div></section><section class="testimonials"><p class="kicker">在这里，为您留出空间</p><div class="quote-grid">{home.testimonials.map(x=><blockquote><span aria-hidden="true">″</span><p>“{x.quote}”</p><cite>— {x.attribution}</cite></blockquote>)}</div></section><Cta locale="zh"/></Base>
<script>
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.body.classList.add('home-motion');
    const sections = document.querySelectorAll('main > section');
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });
    sections.forEach((section, index) => {
      if (index === 0) section.classList.add('is-visible');
      observer.observe(section);
    });
  }
</script>
