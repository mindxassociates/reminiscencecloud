---
import Base from '../../layouts/Base.astro'; import Cta from '../../components/Cta.astro'; import home from '../../content/pages/zh/home.json'; import settings from '../../content/settings.json';
---
<Base title="Reminiscence Cloud" locale="zh" counterpart="/"><section class="hero"><div class="hero-copy"><p class="kicker">{home.eyebrow}</p><h1>{home.title}</h1><p>{home.intro}</p><a class="button" href={settings.schedulingUrlZh}>预约免费 15 分钟咨询</a><p class="availability">{home.availability}</p></div><figure class="hero-art"><img src="https://images.pexels.com/photos/26078147/pexels-photo-26078147.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=1800" alt="平静海面与舒展的云层" fetchpriority="high" referrerpolicy="no-referrer"></figure></section><section class="intro-story"><div><p class="kicker">认识苗秀云 Sharon Miao，LCSW</p><h2>{home.welcomeTitle}</h2><p>{home.welcomeBody}</p><p>{home.welcomeBodyTwo}</p></div><img src="/images/coast.jpg" alt="心理咨询师苗秀云 Sharon Miao，LCSW 坐在海边长椅上"></section><section class="soft focus-section"><div class="section-head"><p class="kicker">关注领域</p><h2>我们可以共同面对的问题</h2></div><div class="focus-grid">{home.areas.map(x=><article><h3>{x.title}</h3><p>{x.body}</p></article>)}</div></section><figure class="visual-pause"><img src="https://images.pexels.com/photos/29438576/pexels-photo-29438576.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=1800" alt="窗边阳光下的座椅与绿植" loading="lazy" referrerpolicy="no-referrer"><figcaption>给自己一点呼吸的空间。</figcaption></figure><section class="testimonials"><p class="kicker">来访者评价</p><div class="quote-grid">{home.testimonials.map(x=><blockquote><span aria-hidden="true">″</span><p>“{x.quote}”</p><cite>— {x.attribution}</cite></blockquote>)}</div></section><Cta locale="zh"/></Base>
