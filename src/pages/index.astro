---
import Base from '../layouts/Base.astro'; import Cta from '../components/Cta.astro'; import home from '../content/pages/home.json'; import settings from '../content/settings.json';
---
<Base title="Reminiscence Cloud" counterpart="/zh/"><section class="hero"><div class="hero-copy"><p class="kicker">{home.eyebrow}</p><h1>{home.title}</h1><p>{home.intro}</p><a class="button" href={settings.schedulingUrl}>Request a Free 15-Minute Consultation</a><p class="availability">{home.availability}</p></div><figure class="hero-art"><img src="https://images.pexels.com/photos/26078147/pexels-photo-26078147.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=1800" alt="Calm sea beneath a wide, softly clouded sky" fetchpriority="high" referrerpolicy="no-referrer"></figure></section><section class="intro-story"><div><p class="kicker">Meet Sharon Miao, LCSW</p><h2>{home.welcomeTitle}</h2><p>{home.welcomeBody}</p><p>{home.welcomeBodyTwo}</p></div><img src="/images/coast.jpg" alt="Sharon Miao, LCSW, psychotherapist seated on a bench by the coast"></section><section class="soft focus-section"><div class="section-head"><p class="kicker">Areas of focus</p><h2>What we can work through together</h2></div><div class="focus-grid">{home.areas.map(x=><article><h3>{x.title}</h3><p><em>{x.body}</em></p></article>)}</div></section><figure class="visual-pause"><img src="https://images.pexels.com/photos/29438576/pexels-photo-29438576.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=1800" alt="A quiet sunlit chair beside a window and houseplant" loading="lazy" referrerpolicy="no-referrer"><figcaption>A little room to breathe.</figcaption></figure><section class="testimonials"><p class="kicker">What clients say</p><div class="quote-grid">{home.testimonials.map(x=><blockquote><span aria-hidden="true">″</span><p><em>{x.quote}</em></p><cite>— {x.attribution}</cite></blockquote>)}</div></section><Cta/></Base>
