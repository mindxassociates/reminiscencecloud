---
import Base from '../layouts/Base.astro'; import Cta from '../components/Cta.astro'; import home from '../content/pages/home.json'; import settings from '../content/settings.json'; import { withBase } from '../paths.js';
---
<Base title="Reminiscence Cloud" counterpart="/zh/"><section class="hero"><div class="hero-copy"><p class="kicker">{home.eyebrow}</p><h1>{home.title}</h1><p>{home.intro}</p><a class="button" href={withBase(settings.schedulingUrl)}>Request a Free 15-Minute Consultation</a><p class="availability">{home.availability}</p></div></section><section class="intro-story"><div><p class="kicker">Meet Sharon Miao, LCSW</p><h2>{home.welcomeTitle}</h2><p>{home.welcomeBody}</p><p>{home.welcomeBodyTwo}</p></div><img src={withBase('/images/coast.jpg')} alt="Sharon Miao, LCSW, psychotherapist seated on a bench by the coast"></section><section class="soft focus-section"><div class="section-head"><p class="kicker">Areas of focus</p><h2>What we can work through together</h2></div><div class="focus-grid">{home.areas.map(x=><article><h3>{x.title}</h3><p><em>{x.body}</em></p></article>)}</div></section><section class="testimonials"><p class="kicker">What clients say</p><div class="quote-grid">{home.testimonials.map(x=><blockquote><span aria-hidden="true">″</span><p><em>{x.quote}</em></p><cite>— {x.attribution}</cite></blockquote>)}</div></section><Cta/></Base>
