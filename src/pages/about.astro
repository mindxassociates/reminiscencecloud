---
import Base from '../layouts/Base.astro'; import Cta from '../components/Cta.astro'; import page from '../content/pages/about.json';
---
<Base title={page.title} counterpart="/zh/about/"><section class="page-hero"><p class="kicker">About</p><h1>{page.heading}</h1><p>{page.subheading}</p></section><section class="split portrait"><img src="/images/coast.jpg" alt="Xiuyun (Sharon) Miao, LCSW seated by the coast"><div><p class="kicker">Psychotherapist</p><h2>{page.name}</h2><p>{page.body}</p><p>{page.secondary}</p></div></section><section class="soft"><div class="section-head"><p class="kicker">Training & credentials</p><h2>Education and certifications</h2></div><div class="credential-grid">{page.credentials.map(x=><article><h3>{x.title}</h3><p>{x.detail}</p></article>)}</div></section><section class="philosophy-wrap"><figure class="botanical-art"><img src="https://images.pexels.com/photos/13217588/pexels-photo-13217588.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=1400" alt="Delicate blue flowers in soft natural light" loading="lazy" referrerpolicy="no-referrer"></figure><div class="prose philosophy"><p class="kicker">My philosophy</p><h2>What I believe about healing</h2>{page.philosophy.map(p=><p>{p}</p>)}</div></section><Cta/></Base>
