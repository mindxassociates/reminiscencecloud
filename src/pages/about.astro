---
import Base from '../layouts/Base.astro'; import Cta from '../components/Cta.astro'; import page from '../content/pages/about.json'; import { withBase } from '../paths.js';
---
<Base title={page.title} counterpart="/zh/about/"><section class="page-hero"><p class="kicker">About</p><h1>{page.heading}</h1><p>{page.subheading}</p></section><section class="split portrait"><img src={withBase('/images/portrait.jpg')} alt="Xiuyun (Sharon) Miao, LCSW seated by the coast"><div><p class="kicker">Psychotherapist</p><h2>{page.name}</h2><p>{page.body}</p><p>{page.secondary}</p></div></section><section class="soft"><div class="section-head"><p class="kicker">Training & credentials</p><h2>Education, licensure & training</h2></div><div class="credential-grid">{page.credentials.map(x=><article><h3>{x.title}</h3><p>{x.detail}</p></article>)}</div></section><section class="prose philosophy"><p class="kicker">My philosophy</p><h2>What I believe about healing</h2>{page.philosophy.map(p=><p>{p}</p>)}</section><Cta/></Base>
