---
import Base from '../layouts/Base.astro'; import Cta from '../components/Cta.astro'; import page from '../content/pages/faq.json'; import { withBase } from '../paths.js';
---
<Base title="Therapy Fees & FAQs | Sharon Miao, LCSW" description="Answers about therapy fees, insurance, session format, English and Mandarin sessions, and starting therapy with Sharon Miao, LCSW in NYC or online." counterpart="/zh/faq/"><section class="page-hero"><p class="kicker">FAQ</p><h1>{page.heading}</h1><p>{page.intro}</p></section><section class="faq">{page.groups.map(group=><section class="faq-group"><h2>{group.title}</h2>{group.items.map(x=>x.answer?<details><summary>{x.question}</summary><p>{x.answer}</p></details>:<div class="faq-question">{x.question}</div>)}</section>)}</section><section class="faq-help"><h2>Still have questions?</h2><p>I'm happy to answer anything that isn't covered here. Reach out and I'll get back to you within 1–2 business days.</p><a class="button" href={withBase('/en/book/')}>Book a Free Consultation</a></section><Cta/></Base>
