---
import Base from '../layouts/Base.astro'; import Cta from '../components/Cta.astro'; import page from '../content/pages/services.json';
---
<Base title={page.title} counterpart="/zh/services/"><section class="page-hero"><p class="kicker">Services</p><h1>{page.heading}</h1><p>{page.intro}</p></section><section class="prose"><p class="kicker">What to expect</p><h2>A collaborative, unhurried process</h2><p>{page.expectation}</p><p>{page.consultation}</p></section><section class="service-list"><div class="section-head"><p class="kicker">Areas of focus</p><h2>What we can work on together</h2></div>{page.items.map((x,i)=><article><span>0{i+1}</span><div><h3>{x.title}</h3><p class="service-tagline">{x.tagline}</p><p>{x.body}</p><ul>{x.methods.map(m=><li>{m}</li>)}</ul></div></article>)}</section><section class="soft"><div class="section-head"><p class="kicker">Session format</p><h2>How we work</h2></div><div class="format-grid">{page.format.map(x=><div><strong>{x.label}</strong><p>{x.value}</p></div>)}</div></section><Cta/></Base>
