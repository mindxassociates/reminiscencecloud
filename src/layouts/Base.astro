---
import settings from '../content/settings.json';
import { withBase, withoutBase } from '../paths.js';
import '../styles/global.css'; import '../styles/content.css'; import '../styles/visual-match.css'; import '../styles/nav-fix.css'; import '../styles/faq-fix.css'; import '../styles/faq-help.css'; import '../styles/legal.css'; import '../styles/original-site.css';
interface Props { title: string; description?: string; locale?: 'en'|'zh'; counterpart?: string; robots?: string; }
const { title, description: suppliedDescription, locale='en', counterpart, robots='index,follow' } = Astro.props;
const path=withoutBase(Astro.url.pathname); const zh=locale==='zh'; const description=suppliedDescription||(zh?'为成年人提供创伤知情心理咨询。':settings.tagline);
const nav=zh?[['/zh/','首页'],['/zh/about/','关于我'],['/zh/services/','服务'],['/zh/blog/','博客'],['/zh/faq/','常见问题'],['/zh/contact/','联系我']]:[['/','Home'],['/about/','About'],['/services/','Services'],['/blog/','Blog'],['/faq/','FAQ'],['/contact/','Reach Out']];
const languageHref=counterpart||(zh?path.replace(/^\/zh/,'')||'/':`/zh${path}`);
const canonical=new URL(withBase(path),Astro.site);
const alternate=new URL(withBase(languageHref),Astro.site);
---
<!doctype html><html lang={zh?'zh-CN':'en'}><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width"><title>{title===settings.practiceName?title:`${title} | ${settings.practiceName}`}</title><meta name="description" content={description}><meta name="robots" content={robots}><link rel="canonical" href={canonical}><link rel="alternate" hreflang={zh?'en':'zh-CN'} href={alternate}><meta property="og:title" content={title}><meta property="og:description" content={description}><meta property="og:type" content="website"><meta property="og:image" content={new URL(withBase('/images/coast.jpg'),Astro.site)}><link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml"><link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500;600&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet"></head><body><a class="skip" href="#main">{zh?'跳至主要内容':'Skip to content'}</a>
<header class="site-header"><a class="brand" href={withBase(zh?'/zh/':'/')} aria-label={zh?'Reminiscence Cloud 中文首页':'Reminiscence Cloud home'}><img class="original-logo" src={withBase('/images/logo-original.png')} alt="Reminiscence Cloud" width="310" height="72"></a><div class="header-actions"><a class="language" href={withBase(languageHref)} lang={zh?'en':'zh-CN'}>{zh?'EN':'中文'}</a><button class="menu" aria-expanded="false" aria-controls="nav"><span>{zh?'菜单':'Menu'}</span></button></div><nav id="nav" aria-label={zh?'主导航':'Primary'}><ul>{nav.map(([href,label])=><li><a href={withBase(href)} aria-current={path===href?'page':undefined}>{label}</a></li>)}<li class="nav-language"><a href={withBase(languageHref)} lang={zh?'en':'zh-CN'}>{zh?'English':'中文'}</a></li></ul></nav></header>
<main id="main"><slot /></main>
<footer><div><a class="brand footer-brand" href={withBase(zh?'/zh/':'/')}><img class="original-logo" src={withBase('/images/logo-original.png')} alt="Reminiscence Cloud" width="310" height="72"></a><p class="preserve">{zh?'为成年人提供创伤知情心理咨询。\n纽约市 · 提供远程咨询':'Trauma-informed psychotherapy for adults.\nNew York City · Telehealth available'}</p></div><div><p><strong>{zh?'导航':'Navigate'}</strong></p><p>{nav.slice(0,5).map(([href,label],i)=><><a href={withBase(href)}>{label}</a>{i<4?' · ':''}</>)}</p></div><div><p><strong>{zh?'联系我':'Reach Out'}</strong></p><p class="preserve">{zh?'迈出第一步，是一种勇气。\n当您准备好了，我在这里。':"Taking the first step is an act of courage.\nI'm here when you're ready."}</p><p><a href={withBase(zh?settings.schedulingUrlZh:settings.schedulingUrl)}>{zh?'预约免费咨询':'Book a Free Consultation'}</a></p><p><a href={settings.instagramUrl}>@reminiscencecloud</a> · <a href={settings.linkedinUrl}>LinkedIn</a></p></div><div class="footer-crisis"><p>Email: <a href={`mailto:${settings.email}`}>{settings.email}</a></p><p>If you or someone you know is experiencing an emergency or crisis and needs immediate help, call <a href="tel:911">911</a> or go to the nearest emergency room. Additional crisis resources can be found <a href={withBase(zh?'/zh/blog/emergency-resources/':'/blog/emergency-resources/')}>here</a>.</p></div><div class="footer-legal"><a href={withBase(zh?'/zh/privacy-policy/':'/privacy-policy/')}>{zh?'网站隐私政策':'Website Privacy Policy'}</a><span> · </span><a href={withBase(zh?'/zh/hipaa-notice/':'/hipaa-notice/')}>{zh?'HIPAA 隐私惯例通知':'HIPAA Notice of Privacy Practices'}</a></div><p class="copyright">© {new Date().getFullYear()} Reminiscence Cloud{zh?'。保留所有权利。· 纽约市，纽约州':'. All rights reserved. · New York City, NY'}</p><p class="footer-profile"><a href="https://www.psychologytoday.com/profile/1274912" target="_blank" rel="noopener noreferrer">Psychology Today · Xiuyun Miao, LCSW</a></p></footer>
<script is:inline>const b=document.querySelector('.menu'),n=document.querySelector('#nav');b?.addEventListener('click',()=>{const o=b.getAttribute('aria-expanded')==='true';b.setAttribute('aria-expanded',String(!o));n?.classList.toggle('open',!o)});</script></body></html>
